{
  "name": "camoo/laravel-mobile-money-payment",
  "description": "Official Laravel integration for the Camoo Payment API, providing service providers, facades, webhook handling, and a Cashier-like developer experience.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "keywords": [
    "laravel",
    "payment",
    "camoo",
    "sdk",
    "cashout",
    "api",
    "webhooks",
    "mobile-money"
  ],
  "homepage": "https://www.camoo.hosting",
  "authors": [
    {
      "name": "Camoo Hosting",
      "email": "camoopay@camoo.sarl"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/contracts": "^9.0|^10.0|^11.0",
    "illuminate/http": "^9.0|^10.0|^11.0",
    "camoo/payment-api": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Camoo\\LaravelPayment\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Camoo\\LaravelPayment\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    },
    "laravel": {
      "providers": [
        "Camoo\\LaravelPayment\\CamooPaymentServiceProvider"
      ],
      "aliases": {
        "CamooPay": "Camoo\\LaravelPayment\\Facades\\CamooPay"
      }
    }
  },
  "support": {
    "issues": "https://github.com/camoo/laravel-payment/issues",
    "source": "https://github.com/camoo/laravel-payment"
  },
  "scripts": {
    "test": "vendor/bin/phpunit --configuration phpunit.xml.dist --colors=always"
  }

}
